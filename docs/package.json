{
  "name": "rust-yaml-gh-pages",
  "version": "0.0.1-1",
  "private": true,
  "description": "Documentation site for the rust-yaml Rust library",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "bun": "^1.3.14",
    "node": ">=24.0.0,<25.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "rustdoc": "mise run docs",
    "predev": "bun run rustdoc",
    "dev": "vitepress dev .",
    "build": "vitepress build .",
    "preview": "vitepress preview . --port ${DOCS_PORT:-5273}",
    "deps": "bunx --bun npm-check-updates -u --target minor && bun install",
    "deps:check": "bunx --bun npm-check-updates --target minor",
    "deps:latest": "bunx --bun npm-check-updates -u --target latest && bun install",
    "prettier:format": "prettier --check .",
    "prettier:format:fix": "prettier --write .",
    "eslint:lint": "eslint --max-warnings 0 .",
    "eslint:lint:fix": "eslint --fix --max-warnings 0 .",
    "fix:all": "bun run eslint:lint:fix && bun run prettier:format:fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.8.0",
    "markdown-it": "14.3.0",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0",
    "vitepress": "^2.0.0-alpha.18"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
